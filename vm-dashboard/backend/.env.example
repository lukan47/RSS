# ESXi / vCenter
ESXI_HOST=vcenter.example.com
ESXI_USER=administrator@vsphere.local
ESXI_PASSWORD=changeme
ESXI_VERIFY_SSL=false

# Proxmox (optional — leave blank to disable)
PROXMOX_HOST=
PROXMOX_USER=
PROXMOX_PASSWORD=
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN_SECRET=
PROXMOX_VERIFY_SSL=false

# Default SSH credentials for VMs (can be overridden per deployment)
DEFAULT_SSH_USER=root
DEFAULT_SSH_PASSWORD=
DEFAULT_SSH_KEY_PATH=

# Active hypervisor: esxi | proxmox
ACTIVE_HYPERVISOR=esxi
